{
  "name": "@remoteagent/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/cli.ts",
    "db:up": "tsx scripts/local-postgres.ts up",
    "db:down": "tsx scripts/local-postgres.ts down",
    "db:smoke": "tsx scripts/local-postgres.ts smoke",
    "gate": "tsx scripts/require-postgres.ts"
  },
  "dependencies": {
    "@remoteagent/contracts": "workspace:*",
    "pg": "8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remoteagent/agent-orchestrator": "workspace:*",
    "@remoteagent/policy": "workspace:*",
    "@types/pg": "8.15.6"
  }
}
