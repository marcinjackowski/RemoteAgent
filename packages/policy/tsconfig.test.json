{
  // Typechecks `src` plus the NON-integration specs.
  //
  // The integration specs are excluded for the reason recorded in `CTF-004`: they
  // reach into `../../database/src` (and its test harness), which is outside this
  // package's `rootDir`, so `tsc` reports TS6059 for every transitively-reached
  // file. The relative import is itself deliberate — `packages/database`
  // devDepends on `@remoteagent/policy` for its own tests, so a manifest edge in
  // this direction makes turbo's build graph cyclic — which means the two
  // constraints (no package cycle, `rootDir` containment) cannot both be satisfied
  // without resolving src-vs-dist repo-wide.
  //
  // `CTF-004` records that resolution as needing its own unit: "osobno rozstrzygnąć
  // konflikt src-vs-dist dla testów importujących harness bazy — inaczej nowo objęte
  // pakiety od razu zaświecą się na czerwono". This exclusion keeps the previously
  // green `typecheck` for `src` and the unit specs (the same shape RA-021's
  // `mcp-tool-broker` uses) without pretending the finding is closed. The excluded
  // specs are still typechecked by vitest's transform at run time and their
  // behaviour is covered by the task gate.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "test"],
  "exclude": ["test/**/*.integration.test.ts"]
}
